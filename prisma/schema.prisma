generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Category {
  DEEP_WORK
  WRITING
  PLANNING
  ADMIN
  PERSONAL
  HEALTH
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  name          String?
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  settings      UserSettings?
  tasks         Task[]
  calendarEvents CalendarEvent[]
  schedulingLogs SchedulingHistory[]

  @@map("users")
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workStart     String   @default("09:00") // 24-hour format "HH:MM"
  workEnd       String   @default("17:30") // 24-hour format "HH:MM"
  bufferMinutes Int      @default(15)      // minutes between scheduled tasks
  dailyFocus    String?                    // Single guiding intention for the day
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_settings")
}

model Task {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  notes           String?
  completed       Boolean            @default(false)
  completedAt     DateTime?
  priority        Priority           @default(MEDIUM)
  category        Category           @default(DEEP_WORK)
  scheduledDate   DateTime?          // The specific day this task is planned for
  scheduledTime   String?            // "HH:MM" format
  durationMinutes Int                @default(30)
  isLocked        Boolean            @default(false) // Protection: AI or auto-rescheduler cannot move locked tasks
  order           Int                @default(0)     // For user manual ordering
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  calendarEvent   CalendarEvent?
  historyEntries  SchedulingHistory[]

  @@index([userId, scheduledDate])
  @@index([userId, completed])
  @@map("tasks")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean  @default(false)
  isExternal  Boolean  @default(false) // True if synced from external provider (e.g. Google Calendar)

  taskId      String?  @unique
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, startTime, endTime])
  @@map("calendar_events")
}

model SchedulingHistory {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action       String    // "SCHEDULED", "RESCHEDULED", "AI_BALANCED", "UNSCHEDULED", "COMPLETED"
  previousTime String?
  newTime      String?
  previousDate DateTime?
  newDate      DateTime?
  reason       String?   // e.g., "User dragged block", "AI rebalance after meeting added"
  canUndo      Boolean   @default(true)
  isUndone     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("scheduling_history")
}
